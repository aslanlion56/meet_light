rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario solo puede leer y escribir sus propias juntas.
    match /users/{uid}/meetings/{meetingId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.startedAt is timestamp
        && request.resource.data.endedAt is timestamp
        && request.resource.data.durationMs is int
        && request.resource.data.participants is list
        && request.resource.data.participants.size() <= 500;
    }
  }
}
